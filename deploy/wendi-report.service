[Unit]
Description=WenDi (问底) daily report
After=network.target wendi.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/wendi
EnvironmentFile=-/etc/wendi.env
ExecStart=/usr/bin/python3 /opt/wendi/daily_report.py
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/wendi -/home/ubuntu/.wendi
