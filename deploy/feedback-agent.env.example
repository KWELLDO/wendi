# 问底反馈 → OpenCode 免费分流 → clds fix/大改方案
# 安装到 ~/.config/wendi/feedback-agent.env，并 chmod 600。
WENDI_FEEDBACK_BASE_URL=https://know.kwelldo.cn
WENDI_ADMIN_TOKEN=replace-with-wendi-admin-token
# 或者用文件（文件权限 600），二选一：
# WENDI_ADMIN_TOKEN_FILE=/home/you/.config/wendi/admin_token

# —— 第一段：OpenCode 免费模型分流 ——
# 不填则从 ~/.local/state/opencode/service.json 自动发现 URL / 密码
# OPENCODE_URL=http://127.0.0.1:49374
# OPENCODE_PASSWORD=replace-with-opencode-service-password
# OPENCODE_PASSWORD_FILE=/home/you/.config/wendi/opencode_password
# 必须确认是免费模型（桥接会查 /api/model 的 cost 是否全 0）
# OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free
# 项目内 .opencode/agents/feedback-triage.md 提供无工具分流 agent
# OPENCODE_AGENT=feedback-triage
# OPENCODE_TRIAGE_TIMEOUT=120

# —— 第二段：clds（只在 fix / big_change 时调用）——
# clds 可执行文件；不填则从 PATH 找 clds
# WENDI_CLDS_BIN=/home/you/.local/bin/clds
# clds --off 的 DeepSeek token 仍在 ~/.config/clds/off.env，不要写到这里。
# WENDI_CLDS_TIMEOUT=300
# WENDI_CLDS_MAX_BUDGET_USD=0.60

# 本地状态、方案输出与 fix 隔离 worktree
# WENDI_FEEDBACK_AGENT_STATE=/home/you/.local/state/wendi-feedback-agent/state.json
# WENDI_FEEDBACK_PLANS_DIR=/home/you/.local/state/wendi-feedback-agent/plans
# WENDI_FIX_WORKTREE_DIR=/home/you/.local/state/wendi-feedback-agent/worktrees

# 轮询间隔与每轮条数
# WENDI_FEEDBACK_INTERVAL=60
# WENDI_FEEDBACK_BATCH=20
