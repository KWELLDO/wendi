# 问底反馈 → 本机 clds 开发 Agent
# 安装到 ~/.config/wendi/feedback-agent.env，并 chmod 600。
WENDI_FEEDBACK_BASE_URL=https://know.kwelldo.cn
WENDI_ADMIN_TOKEN=replace-with-wendi-admin-token
# 或者用文件（文件权限 600），二选一：
# WENDI_ADMIN_TOKEN_FILE=/home/you/.config/wendi/admin_token

# clds 可执行文件；不填则从 PATH 找 clds
# 本机实测路径：/home/you/.local/bin/clds
# WENDI_CLDS_BIN=/home/you/.local/bin/clds

# clds --off 的 DeepSeek token 仍在 ~/.config/clds/off.env，
# 不要写到这里；脚本不会读取或转发它。

# 单次 clds 超时与预算上限
# WENDI_CLDS_TIMEOUT=300
# WENDI_CLDS_MAX_BUDGET_USD=0.60

# 本地幂等状态与方案输出目录
# WENDI_FEEDBACK_AGENT_STATE=/home/you/.local/state/wendi-feedback-agent/state.json
# WENDI_FEEDBACK_PLANS_DIR=/home/you/.local/state/wendi-feedback-agent/plans

# 轮询间隔与每轮条数
# WENDI_FEEDBACK_INTERVAL=60
# WENDI_FEEDBACK_BATCH=20
