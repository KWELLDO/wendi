[Unit]
Description=WenDi (问底) explainer backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/wendi
EnvironmentFile=/etc/wendi.env
# 材料解析依赖 kreuzberg：Debian 13 PEP 668，必须用 /opt/wendi/.venv（deploy.sh 负责创建）
ExecStart=/opt/wendi/.venv/bin/python -u /opt/wendi/server.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
# 轻量加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/wendi -/home/ubuntu/.wendi

[Install]
WantedBy=multi-user.target
