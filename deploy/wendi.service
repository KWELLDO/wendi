[Unit]
Description=WenDi (问底) explainer backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/wendi
EnvironmentFile=/etc/wendi.env
ExecStart=/usr/bin/python3 /opt/wendi/server.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
# 轻量加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/wendi

[Install]
WantedBy=multi-user.target
